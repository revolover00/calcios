# Groq Vision API endpoint (or your own OpenAI-compatible Vision proxy URL)
VITE_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Fastest free-tier multimodal Vision model on Groq (~450+ tokens/sec)
VITE_GROQ_MODEL=qwen/qwen3.8-27b

# Optional build-time Groq API key (for private/proxied builds or local dev)
VITE_GROQ_API_KEY=
