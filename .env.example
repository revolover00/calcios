# Optional OpenAI-compatible vision endpoint and model (these are public settings).
# Never put API secrets in VITE_* variables: static browser bundles are public.
VITE_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
VITE_GROQ_MODEL=qwen/qwen3.8-27b

# For the direct Groq endpoint, enter your own key into the scanner while the app is open.
# The key is held in memory only and is not stored by Calcios. For a shared app key,
# deploy a server-side proxy and point VITE_GROQ_API_URL at that proxy instead.
